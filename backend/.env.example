# Copy to .env and adjust. PostgreSQL setup:
#   1. createdb ipc_school
#   2. psql -d ipc_school -f database/skema.sql
#      (or: npm run db:setup)
#   3. set a real bcrypt hash for the superadmin row + JWT_SECRET

# Option A: single connection string (takes precedence when set)
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipc_school

# Option B: individual variables
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_NAME=ipc_school

JWT_SECRET=change_this_to_a_long_random_string_in_production
SUPERADMIN_SETUP_PASSWORD=admin123
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000
